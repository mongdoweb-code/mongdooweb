# ฐานข้อมูล PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/mongdoweb?schema=public"

# ที่เก็บไฟล์ (สลิป รูปสไลด์ รูปสินค้า โลโก้): local | s3
STORAGE_DRIVER=local

# เมื่อ STORAGE_DRIVER=s3 (Railway Bucket / Cloudflare R2 / AWS S3 — bucket ต้องเป็น private)
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_PREFIX=mongdoweb        # โฟลเดอร์ย่อยใน bucket (ไม่บังคับ)
# S3_FORCE_PATH_STYLE=true   # ค่าเริ่มต้น: true เมื่อมี S3_ENDPOINT

# Railway: ตอน build ใช้ URL สาธารณะของฐานข้อมูล (ตั้งเป็น ${{Postgres.DATABASE_PUBLIC_URL}})
# DATABASE_PUBLIC_URL=

# รหัสผ่านแอดมินคนแรกตอน seed (เปลี่ยนก่อนขึ้นจริง)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me

# โฟลเดอร์เก็บไฟล์อัปโหลดเมื่อ STORAGE_DRIVER=local (ต้องสำรองข้อมูลโฟลเดอร์นี้ด้วย)
UPLOAD_DIR=uploads

# URL หลักของเว็บ (ใช้ทำลิงก์เต็มในรูปแชร์/SEO)
SITE_URL=https://www.mongdooweb.com

# แจ้งเตือน LINE (Messaging API) — คัดลอกจาก LINE Developers Console ของ OA @mongdoweb
# ดูขั้นตอนที่หลังบ้าน › แจ้งเตือน LINE · เว้นว่างไว้ = ไม่ส่งแจ้งเตือน
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# งานประจำวัน /api/cron/daily (ยกเลิกออเดอร์ค้าง, แจ้งสินค้าใกล้หมด, สรุปรายวัน LINE) — ข้อความสุ่มยาว ๆ · เว้นว่าง = ปิด
# ดู docs/DEPLOY.md หัวข้อ "งานประจำวัน (Cron)"
CRON_SECRET=

# อีเมลแจ้งลูกค้า (รับคำสั่งซื้อ / ชำระแล้ว / จัดส่ง) — ค่าด้านล่างเป็นค่าจำลอง ยังส่งจริงไม่ได้
# ใส่ค่าจริงจากผู้ให้บริการอีเมล (เช่น Gmail App Password, SendGrid, Mailgun) แล้วเปิด "ส่งอีเมลลูกค้า" ในหลังบ้าน › ตั้งค่าร้าน
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=change-me
SMTP_FROM="ร้านมองดูเว็บ <no-reply@example.com>"
