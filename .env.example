# ฐานข้อมูล PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/mongdoweb?schema=public"

# ที่เก็บไฟล์ (สลิป รูปสไลด์ รูปสินค้า โลโก้): local | s3
STORAGE_DRIVER=local

# รหัสผ่านแอดมินคนแรกตอน seed (เปลี่ยนก่อนขึ้นจริง)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me

# โฟลเดอร์เก็บไฟล์อัปโหลดเมื่อ STORAGE_DRIVER=local (ต้องสำรองข้อมูลโฟลเดอร์นี้ด้วย)
UPLOAD_DIR=uploads

# URL หลักของเว็บ (ใช้ทำลิงก์เต็มในรูปแชร์/SEO)
SITE_URL=https://www.mongdooweb.com

# แจ้งเตือน LINE (Messaging API) — คัดลอกจาก LINE Developers Console ของ OA @mongdoweb
# ดูขั้นตอนที่หลังบ้าน › แจ้งเตือน LINE · เว้นว่างไว้ = ไม่ส่งแจ้งเตือน
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
